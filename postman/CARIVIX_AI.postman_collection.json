    {
      "name": "3. AI Integration & RAG Endpoints",
      "item": [
        {
          "name": "AI Query - RAG Route (Direct Factual)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"NLP correctly routed to RAG\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.selected_route).to.eql(\"rag\");",
                  "    pm.expect(jsonData.rag_context.retrieved_chunks.length).to.be.at.least(1);",
                  "    pm.expect(jsonData.final_response).to.include(\"CARIVIX\");",
                  "});"
                ],
                "type": "text/javascript"
              }
