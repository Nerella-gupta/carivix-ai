        {
          "name": "AI Query - Out-of-Domain Refusal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Correctly declines to hallucinate on out-of-domain query\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    var resp = (jsonData.final_response || \"\").toLowerCase();",
                  "    var hasRefusal = resp.includes(\"not found\") || resp.includes(\"information not\") || resp.includes(\"does not contain\");",
                  "    pm.expect(hasRefusal).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
